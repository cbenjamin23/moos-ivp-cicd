Behavior = BHV_Waypoint
{
  name      = transit
  pwt       = 100
  condition = MODE == TRANSITING
  endflag   = ARRIVED = true
  endflag   = TRANSIT = false
  endflag   = DESIRED_SPEED = 0
  perpetual = false
  speed     = $(STOCK_SPD)
  capture_line   = true
  capture_radius = 4
  slip_radius    = 12
  points         = 12,-121
  repeat         = 0
}

Behavior = BHV_OpRegionV26
{
  name      = opreg
  pwt       = 300
  condition = MODE == ACTIVE
  updates   = OPREGION_UPDATES
  dynamic_region_var = OPREGION_CORE_POLY

  core_poly = border={0,-135:30,-135:30,-107:0,-107},label=entry_border # poly={0,-135:30,-135:30,-107:0,-107},label=entry_cover
  lapse_dist  = 2
  breach_dist = 12
  stay_in_enabled = true
  get_back_enabled = true
  min_util_eta = 4
  max_util_eta = 15
  recover_spd = 1
  trigger_on_poly_entry = true
  trigger_entry_time = 0.5
  trigger_breach_time = 0

  enteringx_flag  = OPREG_EXEC_TICK=$[SECS_ENTERING]
  containedx_flag = OPREG_EXEC_TICK=$[SECS_CONTAINED]
  lapsed_flag      = SAVE_REGION_BREACHED=true
  lapsedx_flag     = SAVE_REGION_RECOVERING=true
  breached_flag    = HALT_REGION_BREACHED=true
  visual_hints = border_edge_color=white,cover_fill_color=gray95
}
