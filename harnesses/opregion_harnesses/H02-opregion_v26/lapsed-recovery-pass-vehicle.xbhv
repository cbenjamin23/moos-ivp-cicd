Behavior = BHV_Waypoint
{
  name      = transit
  pwt       = 100
  condition = MODE == TRANSITING
  endflag   = ARRIVED = true
  endflag   = TRANSIT = false
  endflag   = DESIRED_SPEED = 0
  perpetual = false
  speed     = $(STOCK_SPD)
  capture_line   = true
  capture_radius = 4
  slip_radius    = 12
  points         = 20,-121:-10,-121
  repeat         = 0
}

Behavior = BHV_OpRegionV26
{
  name      = opreg
  pwt       = 300
  condition = MODE == ACTIVE
  updates   = OPREGION_UPDATES
  dynamic_region_var = OPREGION_CORE_POLY

  // Keep the normal route clear of contained-state avoidance. The timed
  // shrink still forces a real lapse and the get-back objective to run.
  core_poly = border={-60,-170:60,-170:60,-70:-60,-70},label=recover_border # poly={-60,-170:60,-170:60,-70:-60,-70},label=recover_cover
  lapse_dist  = 2
  breach_dist = 22
  stay_in_enabled = true
  get_back_enabled = true
  min_util_eta = 4
  max_util_eta = 15
  recover_spd = 1
  trigger_on_poly_entry = false
  trigger_entry_time = 0
  trigger_breach_time = 0

  containedx_flag = OPREG_EXEC_TICK=$[SECS_CONTAINED]
  lapsed_flag      = SAVE_REGION_BREACHED=true
  lapsedx_flag     = SAVE_REGION_RECOVERING=true
  breached_flag    = HALT_REGION_BREACHED=true
  visual_hints = border_edge_color=white,cover_fill_color=gray95
}
