Behavior = BHV_Waypoint
{
  name      = transit
  pwt       = 100
  condition = MODE == TRANSITING
  endflag   = ARRIVED = true
  endflag   = TRANSIT = false
  endflag   = DESIRED_SPEED = 0

  perpetual = false
  speed     = $(STOCK_SPD)
  capture_line   = true
  capture_radius = 4.0
  slip_radius    = 12.0
  points         = 34,-121:10,-121
  repeat         = 0
}

Behavior = BHV_OpRegionV24
{
  name      = opreg
  pwt       = 300
  condition = MODE == ACTIVE
  updates   = OPREGION_UPDATES
  runxflag  = OPREG_EXEC_TICK=$[SECS_IN_HALT_POLY]

  core_poly = pts={-23,-135:47,-135:47,-107:-23,-107}
  save_poly = pts={-23,-135:27,-135:27,-107:-23,-107}
  halt_poly = pts={-49,-161:49,-161:49,-81:-49,-81}

  trigger_on_poly_entry = true
  trigger_entry_time    = 0.5
  trigger_exit_time     = 0.5
  recover_spd           = 1.0

  save_flag          = SAVE_REGION_BREACHED=true
  savex_flag         = SAVE_REGION_RECOVERING=true
  breached_poly_flag = HALT_REGION_BREACHED=true
  breached_time_flag = TIME_LIMIT_BREACHED=true

  runxflag = OPREG_SECS_IN_HALT=$[SECS_IN_HALT_POLY]
  runxflag = OPREG_SECS_OUT_HALT=$[SECS_OUT_HALT_POLY]
  runxflag = OPREG_SECS_OUT_SAVE=$[SECS_OUT_SAVE_POLY]
}
