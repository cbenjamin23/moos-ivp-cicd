ProcessConfig = uTimerScript
{
  AppTick   = 10
  CommsTick = 10

  condition = DEPLOY = true

  event = var=OPREG_DEPTH_INPUT, val=5, time=2
  // Keep uSimMarineV22 as the only NAV_DEPTH publisher. Direct NAV_DEPTH
  // injection races with its surface readings on a busy runner.
  event = var=USM_RESET, val="depth=5", time=2
}
